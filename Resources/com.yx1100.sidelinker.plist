<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.yx1100.sidelinker</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/SideLinker</string>
	<key>RunAtLoad</key>
	<true/>
	<!-- 崩溃时由 launchd 拉起，启动后会恢复被关闭的显示器；从菜单正常退出则不拉起 -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
